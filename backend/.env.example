# Copiar a .env y completar. NO versionar .env (ya esta en .gitignore).

# ---------- Servidor ----------
PORT=3000
# En produccion debe ser el dominio del frontend, separado por comas. "*" deja
# la API de incidents/ubicaciones abierta a cualquier origen.
CORS_ORIGIN=*

# ---------- Autenticacion (obligatorio) ----------
# Firma los access tokens. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<pega-aqui-un-secreto-aleatorio-de-48-bytes>
# Duracion del access token (formato de jsonwebtoken, p. ej. 15m, 1h)
JWT_EXPIRES_IN=15m

# ---------- Base de datos (Supabase / PostgreSQL) ----------
# Conexion directa (solo IPv6; requiere una red con IPv6 habilitada):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Session pooler (IPv4). Recomendado si tu red no tiene IPv6, porque el proyecto
# usa SQL parametrizado y el transaction pooler (puerto 6543) no admite
# prepared statements:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase exige SSL. Poner en false solo para una BD local sin SSL.
DB_SSL=true

# ---------- Supabase Storage (bucket de evidencias) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET=evidencias
