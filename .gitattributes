# Normalizacion de finales de linea: el repo guarda LF siempre.
# (El historial remoto venia en CRLF; los archivos locales estan en LF.)
* text=auto eol=lf

# Scripts de shell siempre LF
*.sh text eol=lf
gradlew text eol=lf

# Batch de Windows siempre CRLF
*.bat text eol=crlf

# Binarios (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.pdf binary
*.z binary
*.icc binary
